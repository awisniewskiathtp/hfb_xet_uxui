<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- "My Preferences" form opened from the user menu -->
    <record id="view_users_form_simple_modif_xet_theme" model="ir.ui.view">
        <field name="name">res.users.preferences.form.xet_theme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="xet_theme" readonly="0"/>
            </xpath>
        </field>
    </record>

    <!-- User form in Settings > Users (administrators) -->
    <record id="view_users_form_xet_theme" model="ir.ui.view">
        <field name="name">res.users.form.xet_theme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']//group[@name='other_preferences']" position="inside">
                <field name="xet_theme" invisible="share"/>
            </xpath>
        </field>
    </record>

</odoo>
